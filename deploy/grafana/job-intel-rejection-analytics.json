{
  "title": "Job Intel - Rejection Analytics",
  "uid": "job-intel-rejection-analytics",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "tags": [
    "job-intel",
    "observability"
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Rejection Analytics",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Top Rejection Reasons (7d)",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(12, job_intel_rejections_7d)",
          "legendFormat": "{{reason}}",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Near Miss Count by Score Band (7d)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "job_intel_near_miss_count_7d{score_band=\"60_74\"}",
          "refId": "A",
          "legendFormat": "60-74"
        },
        {
          "expr": "job_intel_near_miss_count_7d{score_band=\"75_89\"}",
          "refId": "B",
          "legendFormat": "75-89"
        },
        {
          "expr": "job_intel_near_miss_count_7d{score_band=\"90_100\"}",
          "refId": "C",
          "legendFormat": "90-100"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Highest Scoring Rejected Opportunities",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "job_intel_vacancy_score_top_7d{scope=\"rejected\"}",
          "refId": "A",
          "legendFormat": "top rejected score"
        },
        {
          "expr": "job_intel_vacancy_score_p90_7d{scope=\"rejected\"}",
          "refId": "B",
          "legendFormat": "p90 rejected score"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Rejection by Source (7d)",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(15, job_intel_rejections_by_source_7d)",
          "legendFormat": "{{source}}: {{reason}}",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          }
        }
      ]
    }
  ]
}