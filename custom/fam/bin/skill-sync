#!/usr/bin/env bash
# Reconciles curator-patched deployed skill copies back into git.
#
# The Hermes background curator (skill_manage) sometimes patches deployed
# skill copies under ~/.hermes/skills/<name>/SKILL.md directly, bypassing
# git. This script folds such drift back into the git-tracked copy under
# ~/.hermes/hermes-agent/custom/skills/<name>/SKILL.md, commits, and pushes.
#
# Rule (content-based, not mtime-based -- mtimes are unreliable across
# rsync/checkout/curator-write ordering and gave no real signal about
# which side actually changed): fold iff (1) the deployed copy's content
# differs from git HEAD's tracked content for this path, AND (2) the
# working-tree copy is itself clean vs HEAD (i.e. nobody has a local,
# uncommitted edit in flight -- a mid-task state we must not clobber).
# Otherwise: skip, with a distinct counter/reason per case.
# Never touches frontmatter/content - verbatim copy.
set -uo pipefail

REPO="$HOME/.hermes/hermes-agent"
SKILLS_DIR="$REPO/custom/skills"
DEPLOY_DIR="$HOME/.hermes/skills"

folded=0
skipped_drift=0
skipped_midtask=0
clean=0

for git_skill_md in "$SKILLS_DIR"/*/SKILL.md; do
  [ -f "$git_skill_md" ] || continue
  name="$(basename "$(dirname "$git_skill_md")")"
  deployed="$DEPLOY_DIR/$name/SKILL.md"
  rel_path="custom/skills/$name/SKILL.md"

  [ -f "$deployed" ] || continue

  head_content="$(git -C "$REPO" show "HEAD:$rel_path" 2>/dev/null)"
  deployed_content="$(cat "$deployed")"
  worktree_content="$(cat "$git_skill_md")"

  if [ "$deployed_content" = "$head_content" ]; then
    clean=$((clean + 1))
    continue
  fi

  # Deployed differs from HEAD. Only fold if the working tree itself is
  # clean vs HEAD -- otherwise there's a local, uncommitted edit in
  # flight and folding would clobber it.
  if [ "$worktree_content" != "$head_content" ]; then
    skipped_midtask=$((skipped_midtask + 1))
    logger -t skill-sync "skipped-midtask $name: working tree differs from HEAD, not folding"
    continue
  fi

  cp "$deployed" "$git_skill_md"
  git -C "$REPO" add -- "$rel_path"
  if git -C "$REPO" commit -m "chore(amina): curator patch auto-commit ($name)" -- "$rel_path" >/dev/null; then
    folded=$((folded + 1))
    logger -t skill-sync "folded $name: deployed drift committed"
    if ! git -C "$REPO" push >/dev/null 2>&1; then
      echo "skill-sync: warning: push failed for $name, commit kept locally"
      logger -t skill-sync "warning $name: push failed, commit kept locally"
    fi
  else
    skipped_drift=$((skipped_drift + 1))
    logger -t skill-sync "skipped-drift $name: commit failed or nothing to commit"
  fi
done

echo "skill-sync: ${folded} folded, ${skipped_drift} skipped-drift, ${skipped_midtask} skipped-midtask, ${clean} clean"
