[Unit]
Description=Alert on consecutive LinkedIn source failures or empty runs

[Service]
Type=oneshot
User=hermes
Group=hermes
EnvironmentFile=/etc/job-intel/job-intel.env
Environment=JOB_INTEL_SOURCE_ALERT_CHANNEL=executive_search_report
Environment=JOB_INTEL_SOURCE_ALERT_THRESHOLD=3
Environment=JOB_INTEL_SOURCE_ALERT_STATE=/var/lib/job-intel/state/linkedin-source-alert.json
WorkingDirectory=__JOB_INTEL_REPO_ROOT__
ExecStart=/usr/bin/env bash __JOB_INTEL_REPO_ROOT__/scripts/job_intel_source_alert.sh
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ReadWritePaths=/var/lib/job-intel /var/log/job-intel
UMask=0077

[Install]
WantedBy=multi-user.target
