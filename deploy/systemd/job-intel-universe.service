[Unit]
Description=Job-intel weekly company universe discovery report (read-only)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hermes
Group=hermes
EnvironmentFile=/etc/job-intel/job-intel.env
Environment=JOB_INTEL_SERVICE_USER=hermes
Environment=JOB_INTEL_SERVICE_GROUP=hermes
Environment=JOB_INTEL_WORKDIR=/home/hermes/.hermes/hermes-agent
WorkingDirectory=/home/hermes/.hermes/hermes-agent
ExecStart=/usr/bin/env bash /home/hermes/.hermes/hermes-agent/scripts/job_intel_host_wrapper.sh universe-discovery
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/job-intel /var/log/job-intel /etc/job-intel /var/lib/browser-desktop
UMask=0077

[Install]
WantedBy=multi-user.target
