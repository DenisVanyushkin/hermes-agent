# Shadow collection environment. Install as /etc/job-intel/job-intel-shadow.env
# with mode 0640, owner root:hermes.
#
# Derived from /etc/job-intel/job-intel.env with three deliberate differences:
#   1. SLACK_BOT_TOKEN and SLACK_APP_TOKEN are absent;
#   2. JOB_INTEL_SLACK_WEBHOOK_URL is absent;
#   3. JOB_INTEL_DELIVERY_DISABLED=1 and JOB_INTEL_RUN_TYPE=shadow are present.
#
# The kill-switch is the load-bearing control. The missing credentials are a
# second, independent barrier: neither is trusted alone.
JOB_INTEL_SERVICE_USER=hermes
JOB_INTEL_SERVICE_GROUP=hermes
JOB_INTEL_ENVIRONMENT=production
JOB_INTEL_WORKDIR=/home/hermes/.hermes/hermes-agent
JOB_INTEL_STATE_DIR=/var/lib/job-intel/state
JOB_INTEL_DB_PATH=/var/lib/job-intel/state/job_intel.sqlite3
JOB_INTEL_BROWSER_RUNTIME_DIR=/var/lib/browser-desktop
JOB_INTEL_BROWSER_PROFILE_DIR=/var/lib/browser-desktop/profiles
JOB_INTEL_SCRIPTS_DIR=/home/hermes/.hermes/hermes-agent/scripts
HERMES_HOME=/home/hermes/.hermes
JOB_INTEL_RUN_TYPE=shadow
JOB_INTEL_DELIVERY_DISABLED=1
