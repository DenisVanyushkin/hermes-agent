[Unit]
Description=Job-intel Phase III observe-only semantic shadow (post-run)
After=network-online.target job-intel-daily.service
Wants=network-online.target

[Service]
Type=oneshot
User=__JOB_INTEL_SERVICE_USER__
Group=__JOB_INTEL_SERVICE_GROUP__
EnvironmentFile=__JOB_INTEL_ENV_FILE__
Environment=JOB_INTEL_SERVICE_USER=__JOB_INTEL_SERVICE_USER__
Environment=JOB_INTEL_SERVICE_GROUP=__JOB_INTEL_SERVICE_GROUP__
Environment=JOB_INTEL_WORKDIR=__JOB_INTEL_REPO_ROOT__
WorkingDirectory=__JOB_INTEL_REPO_ROOT__
ExecStart=__JOB_INTEL_REPO_ROOT__/venv/bin/python __JOB_INTEL_REPO_ROOT__/scripts/job_intel_semantic_shadow.py
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/job-intel /var/log/job-intel
UMask=0077

[Install]
WantedBy=multi-user.target
