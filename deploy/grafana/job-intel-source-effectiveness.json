{
  "title": "Job Intel - Source Effectiveness",
  "uid": "job-intel-source-effectiveness",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "tags": [
    "job-intel",
    "observability"
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Source Effectiveness",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Found / Executive / Accepted / Notified by Source (7d)",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "job_intel_source_found_7d",
          "legendFormat": "{{source}} found",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          }
        },
        {
          "refId": "B",
          "expr": "job_intel_source_executive_7d",
          "legendFormat": "{{source}} executive",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          }
        },
        {
          "refId": "C",
          "expr": "job_intel_source_accepted_7d",
          "legendFormat": "{{source}} accepted",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          }
        },
        {
          "refId": "D",
          "expr": "job_intel_source_notified_7d",
          "legendFormat": "{{source}} notified",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Accepted Opportunities by Source",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "job_intel_source_accepted_7d",
          "legendFormat": "{{source}}",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Executive Density by Source",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "job_intel_source_executive_7d / clamp_min(job_intel_source_found_7d, 1)",
          "legendFormat": "{{source}}",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          }
        }
      ]
    }
  ]
}