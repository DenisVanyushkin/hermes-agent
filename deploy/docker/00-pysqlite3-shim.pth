# Alias sqlite3 -> pysqlite3 (SQLite >= 3.53.4) inside the container.
#
# The Debian trixie base ships libsqlite3 3.46.1: inside the WAL-reset
# affected range (fixed upstream in 3.51.3) and, per the Debian security
# tracker, unpatched for CVE-2026-11822 / 11824 / 50813. This container opens
# the same WAL database as the host processes, and the corruption race needs
# only two participants.
#
# A .pth and NOT a sitecustomize.py, deliberately and for the same reason as
# on the host: `site.execsitecustomize()` does a plain `import sitecustomize`,
# so a single shadowing file anywhere earlier on sys.path silences it (Debian
# ships one at /usr/lib/pythonX.Y/sitecustomize.py). Every .pth in
# site-packages is processed instead, so there is nothing to shadow. The
# current base images happen to have no sitecustomize, but a base-image bump
# could introduce one, and this file must not depend on that.
#
# Plan: docs/superpowers/plans/2026-07-30-sqlite-self-supplied-runtime.md
import sys, pysqlite3, pysqlite3.dbapi2; sys.modules.setdefault("sqlite3", pysqlite3); sys.modules.setdefault("sqlite3.dbapi2", pysqlite3.dbapi2)
