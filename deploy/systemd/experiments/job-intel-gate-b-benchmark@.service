[Unit]
Description=Job Intel Gate B description evidence benchmark
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=hermes
Group=hermes
UMask=0077
StateDirectory=job-intel-gate-b-description-evidence
StateDirectoryMode=0750
WorkingDirectory=/var/lib/job-intel-gate-b-description-evidence
Environment=PYTHONNOUSERSITE=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/usr/bin/test -d ${STATE_DIRECTORY}
# %i is the externally supplied whole-artifact hash, not a mutable pointer.
ExecStart=/usr/bin/env /var/lib/job-intel-gate-b-artifacts/%i/runtime/scripts/job_intel_gate_b_benchmark.sh run-description-evidence
Restart=no
TimeoutStartSec=2h
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=read-only
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
ReadOnlyPaths=/var/lib/job-intel-gate-b-artifacts/%i
ReadOnlyPaths=/home/hermes/.hermes/job_intel/experiments/gate-a
ReadOnlyPaths=/home/hermes/.hermes/job_intel/experiments/gate-b
ReadOnlyPaths=/home/hermes/.hermes/private/career/denis_vanyushkin_structured_resume_v1_1.json
InaccessiblePaths=/home/hermes/.hermes/state.db
InaccessiblePaths=/home/hermes/.hermes/job_intel/job_intel.sqlite3
InaccessiblePaths=/home/hermes/.hermes/job_intel/job_intel.sqlite3-wal
InaccessiblePaths=/home/hermes/.hermes/job_intel/job_intel.sqlite3-shm
InaccessiblePaths=/home/hermes/.hermes/job_intel/outbox
InaccessiblePaths=/home/hermes/.hermes/sessions
InaccessiblePaths=/home/hermes/.cache
InaccessiblePaths=/var/lib/browser-desktop/profiles
StandardOutput=journal
StandardError=journal
