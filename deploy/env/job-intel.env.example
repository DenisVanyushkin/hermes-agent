# Job-intel host runtime environment.
#
# The installer writes the deployed copy to /etc/job-intel/job-intel.env
# with mode 0600. Keep this example checked in as a template only.

JOB_INTEL_SERVICE_USER=hermes
JOB_INTEL_SERVICE_GROUP=hermes
JOB_INTEL_ENVIRONMENT=production
JOB_INTEL_WORKDIR=/home/hermes/.hermes/hermes-agent
JOB_INTEL_STATE_DIR=/var/lib/job-intel/state
JOB_INTEL_DB_PATH=/var/lib/job-intel/state/job_intel.sqlite3
JOB_INTEL_BROWSER_RUNTIME_DIR=/var/lib/browser-desktop
JOB_INTEL_BROWSER_PROFILE_DIR=/var/lib/browser-desktop/profiles
JOB_INTEL_BROWSER_PROFILE_DIR_LINKEDIN=/var/lib/browser-desktop/profiles/linkedin
JOB_INTEL_BROWSER_PROFILE_DIR_HH=/var/lib/browser-desktop/profiles/hh
JOB_INTEL_BROWSER_PROFILE_DIR_COMPANY_CAREER=/var/lib/browser-desktop/profiles/company-career
JOB_INTEL_SCRIPTS_DIR=/home/hermes/.hermes/hermes-agent/scripts
JOB_INTEL_EXPECTED_GIT_COMMIT=
JOB_INTEL_TARGET_COMPANY_BROWSER=0
JOB_INTEL_TARGET_HTTP_TIMEOUT_SECONDS=8
JOB_INTEL_ENRICHMENT_MIN_INTERVAL_DAYS=14
# Optional: set only when Slack delivery is configured on the host.
JOB_INTEL_SLACK_WEBHOOK_URL=
