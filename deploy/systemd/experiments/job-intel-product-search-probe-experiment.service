[Unit]
Description=Bounded Job Intel Product Search acquisition probe experiment
After=network-online.target
Wants=network-online.target
BindsTo=job-intel-browser-bootstrap.service
After=job-intel-browser-bootstrap.service

[Service]
Type=oneshot
User=hermes
Group=hermes
Environment=PYTHONNOUSERSITE=1
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/job-intel/product-search-probe-experiment.env
ExecStart=/usr/bin/env bash ${PRODUCT_SEARCH_RUNTIME_ROOT}/scripts/job_intel_product_search_experiment.sh run ${PRODUCT_SEARCH_EXPERIMENT_MANIFEST}
NoNewPrivileges=yes
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/hermes/.hermes/job_intel/experiments/gate-a

[Install]
WantedBy=multi-user.target
